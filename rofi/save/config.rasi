/************************************************
 meow
 ***********************************************/

configuration {
    modi: "drun,window";
    width: 600;
    sidebar-mode: true;
    lines: 10;
    show-icons: true;
    icon-theme: "Pop+";
    fullscreen: false;
    show-match: false;
    separator-style: "solid";
    hide-scrollbar: true;
}

* {
    /* Base colors */
    bg-color: rgba(0, 0, 0, 1);
    bg-hover: rgba(0, 0, 0, 0.3);
    bg-selected: rgba(255, 255, 255, 0.1);
    text-color: rgba(255, 255, 255, 0.9);
    text-color-muted: rgba(255, 255, 255, 0.6);
    border-light: rgba(255, 255, 255, 0.1);
    border-light-hover: rgba(255, 255, 255, 0.2);

    background-color: transparent;
    border-color: @border-light;
    spacing: 2;
    transparency: "real";
    border-radius: 10px;
}

window {
    background-color: @bg-color;
    border: 0;
    padding: 20px;
    width: 600px;
}

mainbox {
    border: 2px;
    padding: 20px;
}

inputbar {
    spacing: 5px;
    padding: 5px;
    border: 0 0 1px 0;
    border-color: @border-light;
    children: [ prompt, entry ];
}

prompt {
    padding: 10px;
    background-color: @bg-hover;
    border: 1px;
    border-color: @border-light;
    text-color: @text-color;
}

entry {
    padding: 10px;
    border: 1px;
    border-color: @border-light;
    text-color: @text-color;
    placeholder-color: @text-color-muted;
}

listview {
    fixed-height: false;
    border: 1px 0 0 0;
    border-color: @border-light;
    spacing: 5px;
    scrollbar: false;
    padding: 5px 0 0;
    columns: 2;
    lines: 5;
}

element {
    padding: 10px;
    spacing: 10px;
    border: 0;
}

element normal.normal {
    background-color: @bg-color;
    text-color: @text-color;
}

element selected.normal {
    background-color: @bg-selected;
    border: 1px;
    border-color: @border-light-hover;
    text-color: @text-color;
}

element alternate.normal {
    background-color: @bg-color;
    text-color: @text-color;
}

mode-switcher {
    padding: 3px;
    border: 1px;
    border-color: @border-light;
}

button {
    padding: 8px;
    text-color: @text-color-muted;
}

button selected {
    background-color: @bg-hover;
    border: 1px;
    border-color: @border-light;
    text-color: @text-color;
}

