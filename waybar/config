{
    "layer": "top",
    "position": "top",
    "height": 40,
    "spacing": 8,
    "margin-top": 8,
// "output": "HDMI-A-1",  // remove this if u dont want ur waybar on 1 monitor.(orcustomizeit)

     
    "modules-left": ["hyprland/workspaces", "custom/hyprland-spotify"],
    "modules-center": ["clock"], 
    "modules-right": ["group/datetime-power"], 
    
    "group/datetime-power": {
        "orientation": "horizontal",
        "modules": ["wlr/taskbar", "custom/space", "pulseaudio", "custom/theme", "custom/arduino", "custom/power"]
    },
    
"custom/space": {
    "format": "   ",   // three normal spaces — increase/decrease to taste
    "tooltip": false
},


    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{icon}",
        "format-icons": {
             "1": "一", "2": "二", "3": "三", "4": "四", "5": "五",
            "6": "六", "7": "七", "8": "八", "9": "九", "10": "十",
            "urgent": "!",
            "focused": "●",
            "default": ""
        }
    },
    
    "custom/hyprland-spotify": {
        "exec": "playerctl metadata -f '{{ artist }} - {{ trunc(title, 25) }}'",
        "exec-if": "playerctl status 2>/dev/null",
        "interval": 2,
        "tooltip": true,
        "on-click": "eww open spotifymenu",
        "format": "{icon} {text}",
     },
    
 

    "clock": {
        "on-click": "",
        "format": "  {:%A %d %Y - %I:%M %p}",
        "format-alt": "{:%d-%m-%Y}"
    },
    
   "custom/theme": {
  "format": "   ",
  "tooltip": "click to find out",
  "on-click": "waypaper --random"
},


    "pulseaudio": {
        "scroll-step": 0.5,
        "max-volume": 150,
        "states": {
            "warning": 30,
            "normal": 89,
            "critical": 150
        },
      "format": "  {volume}%",
      "format-muted": "   0%",  
        "on-click": "pavucontrol",
        "tooltip": false
    },

    "custom/power": {
        "format": "   󰐥 ",
        "tooltip": "Power Menu",
        "on-click": "eww open pwrmnu"
    },
  "custom/arduino": {
  "format": "  A",
  "tooltip": false,
  "on-click": "eww open appmenu",

"wlr/taskbar": {
	"format": "{icon}",
	"icon-size": 14,
	"icon-theme": "Numix-Circle",
	"tooltip-format": "{title}",
	"on-click": "activate",
	"on-click-middle": "close",
	"ignore-list": [
	    "Alacritty"
	],
	"app_ids-mapping": {
		"firefoxdeveloperedition": "firefox-developer-edition"
	},
	"rewrite": {
		"Firefox Web Browser": "Firefox",
		"Foot Server": "Terminal"
	} 
   }
 }
}
