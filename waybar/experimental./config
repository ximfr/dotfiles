{
    "layer": "top",
    "position": "top", 
    "height": 40,
    "spacing": 8,
    "margin-top": 8,
    "margin-left": 500,
    "margin-right": 500,

    "modules-left": ["pulseaudio", "custom/spotify"],
    "modules-center": ["hyprland/workspaces"],
    "modules-right": ["custom/calendar", "custom/random-wallpaper", "custom/lock", "custom/power"],

    "custom/calendar": {
        "format": "󰃭",
        "tooltip": false,
        "on-click": "eww open calendarwidget",
        "on-click-right": "eww close calendarwidget"
    },

    "custom/random-wallpaper": {
        "format": "у°‘¤", 
        "tooltip-format": "Random Wallpaper",
        "on-click": "waypaper --random"
    },

    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{icon}",
        "format-icons": {
            "1": "дёЂ",
            "2": "дєЊ",
            "3": "дё‰", 
            "4": "е››",
