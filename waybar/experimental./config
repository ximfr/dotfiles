    "custom/spotify": {
        "format": "в™Є {}",
        "max-length": 40,
        "interval": 5,
        "exec": "~/.config/waybar/scripts/spotify.sh",
        "exec-if": "pgrep spotify", 
        "on-click": "~/.config/waybar/scripts/spotify-gui.sh",
        "on-scroll-up": "playerctl next 2>/dev/null || true",
        "on-scroll-down": "playerctl previous 2>/dev/null || true",
        "tooltip": true
    }
