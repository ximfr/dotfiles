{
    "layer": "top",
    "position": "top",
    "height": 40,
    "spacing": 8,
    "margin-top": 8,
    "output": "HDMI-A-1",  // remove this if u dont want ur waybar on 1 monitor.(orcustomizeit)

     
    "modules-left": ["hyprland/workspaces", "custom/hyprland-spotify"],
    "modules-center": ["clock", "custom/cava"], 
    "modules-right": ["group/datetime-power", "custom/cava"], 
    
    "group/datetime-power": {
        "orientation": "horizontal",
        "modules": ["pulseaudio", "custom/power", "custom/theme"]
    },


    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{icon}",
        "format-icons": {
             "1": "一", "2": "二", "3": "三", "4": "四", "5": "五",
            "6": "六", "7": "七", "8": "八", "9": "九", "10": "十",
            "urgent": "!",
            "focused": "●",
            "default": ""
        }
    },
    
 

    "clock": {
        "on-click": "",
        "format": "  {:%A - %B %d, %Y - %I:%M %p}",
        "format-alt": "{:%d-%m-%Y}"
    },
    
   "custom/theme": {
  "format": "   ",
  "tooltip": "Change Waybar Theme",
  "on-click": "~/.config/waybar/scripts/waybar-theme.sh"
},


    "pulseaudio": {
        "scroll-step": 0.5,
        "max-volume": 150,
        "states": {
            "warning": 30,
            "normal": 89,
            "critical": 150
        },
      "format": "  {volume}%",
      "format-muted": "   0%",  
        "on-click": "pavucontrol",
        "tooltip": false
    },

    "custom/power": {
        "format": "   󰐥 ",
        "tooltip": "Power Menu",
        "on-click": "eww open pwrmnu"
    },


"custom/hyprland-spotify": {
        "exec": "playerctl metadata -f '{{ artist }} - {{ trunc(title, 25) }}'",
        "exec-if": "playerctl status 2>/dev/null",
        "interval": 2,
        "tooltip": true,
        "on-click": "playerctl play-pause",
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous",
        "format": "{icon} {text}",
        "format-icons": {
            "Playing": "  ",
            "Paused": " ",
            "default": ""
        }
    }
}


