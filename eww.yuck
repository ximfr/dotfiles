;; Music vars
(defpoll SONG :interval "1s" `scripts/music_info --song`)
(defpoll ARTIST :interval "1s" `scripts/music_info --artist`)
(defpoll STATUS :interval "1s" `scripts/music_info --status`)
(defpoll CURRENT :interval "1s" `scripts/music_info --time`)
(defpoll COVER :interval "1s" `scripts/music_info --cover`)
(defpoll CTIME :interval "1s" `scripts/music_info --ctime`)
(defpoll TTIME :interval "1s" `scripts/music_info --ttime`)

(defwindow pwrmnu
  :monitor 0
  :geometry (geometry :width "100%" :height "100%" :anchor "center")
  :stacking "overlay"
  :focusable false
  (eventbox :onclick "eww close pwrmnu" ; Close on any click
    (box :orientation "horizontal" :class "main-box"
      (lock)
      (sleep)
      (logout)
      (reboot)
      (power-off)
    )
  )
)




  





(defwidget lock []
  (box :orientation "horizontal" :align "center" :class "lock-box"
    (button :onclick "hyprlock ; eww close pwrmnu"
      (label :text " 󰌾 " :class "sleep-text"))
  )
)
(defwidget logout []
  (box :orientation "horizontal" :align "center" :class "logout-box"
    (button :onclick "niri msg action quit; hyprctl dispatch exit"
      (label :text "  " :class "sleep-text"))
  )
)
(defwidget reboot []
  (box :orientation "horizontal" :align "center" :class "reboot-box"
    (button :onclick "reboot"
      (label :text "  " :class "sleep-text"))
  )
)
(defwidget power-off []
  (box :orientation "horizontal" :align "center" :class "power-off-box"
    (button :onclick "poweroff"
      (label :text "  " :class "sleep-text"))
  )
)
(defwidget sleep []
  (box :orientation "horizontal" :align "center" :class "sleep-box"
    (button :onclick "systemctl suspend ; eww close pwrmnu"
      (label :text " 󰒲 " :class "sleep-text"))
  )
)


; new thig here 

(defvar current_volume 50)
(defvar actual_volume 75)
(defvar is_muted false)

(defwidget volume_popup []
  (box :class "volume-popup"
       :orientation "v"
       :space-evenly false
       :spacing 10
    (box :orientation "h"
         :space-evenly false
         :spacing 15
         :halign "center"
      (label :class "volume-icon"
             :text {is_muted ? "🔇" :
                    current_volume <= 0 ? "󰝟 " : 
                    current_volume <= 30 ? "󰕿" : 
                    current_volume <= 70 ? "󰖀" : "󰕾 "})
      (label :class "volume-text"
             :text {is_muted ? "MUTED" : "${actual_volume}%"}))
    (box :class "volume-bar-container"
         :halign "fill"
      (scale :class "volume-bar"
             :value {is_muted ? 0 : current_volume}
             :min 0
             :max 100
             :onchange "eww update volume_slider_value={}"))))

(defwindow volume_window
  :monitor 0
  :geometry (geometry :x "50%"
                     :y "80px"
                     :width "300px"
                     :height "80px"
                     :anchor "top center")
  :stacking "overlay"
  :reserve (struts :distance "0px" :side "top")
  :windowtype "normal"
  :wm-ignore true
  :focusable true  ; Changed to true for keybindings
  :keybind "Escape;BackSpace"  ; Add ESC key support
  :layer "top" 
  (volume_popup))

; Add this new widget to handle slider changes
(defwidget volume_slider_handler []
  (box :onscroll "eww update volume_slider_value=$(echo \"$EWW_SCROLL_AMOUNT * 5 + $volume_slider_value\" | bc | awk '{if ($1 < 0) print 0; else if ($1 > 100) print 100; else print $1}')"
       :onchange "./volume_monitor.sh slider $volume_slider_value"
       (box :visible false)))
       
       
 
(defpoll time_str :interval "1s"
              :initial "initial-value"  ; optional, defaults to poll at startup
              :run-while time-visible   ; optional, defaults to 'true'
  `date +%H:%M:%S | sed 's/0/O/g'`)


;(defpoll enabled :interval "1s"
;    :initial false
;    `date +"%s" | awk '{a = $1 % 2}{ if (a == 1) {print "true"} else {print "false"}}'`)

(defvar time_expand false)

(defwidget time []
    (eventbox
    :onhover `eww update time_expand=true`
    :onhoverlost `eww update time_expand=false`
        (info-box
            (label 
                :class "heading time"
                :text "${replace(formattime(EWW_TIME, '%H:%M:%S'), '0', 'O')}")
        )
    )
)

;; Music
(defwidget music [] 
	(box :class "genwin" :orientation "h" :space-evenly "false" :vexpand "false" :hexpand "false" 
		(box :class "album_art" :vexpand "false" :hexpand "false" :style "background-image: url('${COVER}');")
		(box :orientation "v" :spacing 20 :space-evenly "false" :vexpand "false" :hexpand "false" 
			(label :halign "center" :class "song" :wrap "true" :limit-width 20 :text SONG)
			(label :halign "center" :class "artist" :wrap "true" :limit-width 15 :text ARTIST)
			(box :orientation "h" :spacing 20 :halign "center" :space-evenly "true" :vexpand "false" :hexpand "false" 
				(button :class "btn_prev" :onclick "scripts/music_info --prev" "玲")
				(button :class "btn_play" :onclick "scripts/music_info --toggle" STATUS)
				(button :class "btn_next" :onclick "scripts/music_info --next" "怜"))
			(box :class "music_bar" :halign "center" :vexpand "false" :hexpand "false" 
				(scale :onscroll "mpc -q seek +1" :min 0 :active "true" :max 100 :value CURRENT)))))
				
				

