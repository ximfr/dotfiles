(defwindow pwrmnu
  :monitor 0
  :geometry (geometry :width "100%" :height "100%" :anchor "center")
  :stacking "overlay"
  :focusable false
  (eventbox :onclick "eww close pwrmnu" ; Close on any click
    (box :orientation "horizontal" :class "main-box"
      (lock)
      (sleep)
      (logout)
      (reboot)
      (power-off)
    )
  )
)




(defwidget lock []
  (box :orientation "horizontal" :align "center" :class "lock-box"
    (button :onclick "hyprlock ; eww close pwrmnu"
      (label :text " 󰌾 " :class "sleep-text"))
  )
)
(defwidget logout []
  (box :orientation "horizontal" :align "center" :class "logout-box"
    (button :onclick "niri msg action quit; hyprctl dispatch exit"
      (label :text "  " :class "sleep-text"))
  )
)
(defwidget reboot []
  (box :orientation "horizontal" :align "center" :class "reboot-box"
    (button :onclick "reboot"
      (label :text " 󰜉 " :class "sleep-text"))
  )
)
(defwidget power-off []
  (box :orientation "horizontal" :align "center" :class "power-off-box"
    (button :onclick "poweroff"
      (label :text "  󰐥 " :class "sleep-text"))
  )
)
(defwidget sleep []
  (box :orientation "horizontal" :align "center" :class "sleep-box"
    (button :onclick "systemctl suspend ; eww close pwrmnu"
      (label :text " 󰒲 " :class "sleep-text"))
  )
)


(defwindow appmenu
  :monitor 0
  :geometry (geometry :width "100%" :height "100%" :anchor "center")
  :stacking "overlay"
  :focusable false
  (eventbox :onclick "eww close appmenu" ; Close on any click
    (box :orientation "horizontal" :class "main-box"
      (arduino)
      (burp-suite)
      (firefox)
      (files)
      (spotify)
    )
  )
)




(defwidget arduino []
  (box :orientation "horizontal" :align "center" :class "lock-box"
    (button :onclick "/home/klode/arduino-ide_nightly-20251105_Linux_64bit/arduino-ide ; eww close appmenu"
      (label :text " A" :class "sleep-text"))
  )
)
(defwidget burp-suite []
  (box :orientation "horizontal" :align "center" :class "logout-box"
    (button :onclick "/home/klode/BurpSuiteCommunity/BurpSuiteCommunity ; eww close  appmenu"
      (label :text " B " :class "sleep-text"))
  )
)
(defwidget firefox []
  (box :orientation "horizontal" :align "center" :class "reboot-box"
    (button :onclick "firefox ; eww closee appmenu"
      (label :text " F " :class "sleep-text"))
  )
)
(defwidget files []
 
 (box :orientation "horizontal" :align "center" :class "power-off-box"
    (button :onclick "nautilus ; eww close appmenu"
      (label :text " N " :class "sleep-text"))
  )
)
(defwidget spotify []
  (box :orientation "horizontal" :align "center" :class "sleep-box"
    (button :onclick "playerctl next ; eww close appmenu"
      (label :text " S " :class "sleep-text"))
  )
)

(defwindow spotifymenu
  :monitor 0
  :geometry (geometry :width "100%" :height "100%" :anchor "center")
  :stacking "overlay"
  :focusable false
  (eventbox :onclick "eww close spotifymenu" ; Close on any click
    (box :orientation "vertical" :class "main-box" :spacing 10 :align "center"
      (Album)
      (box :orientation "horizontal" :align "center" :spacing 15
        (Previous)
        (Play/Pause)
        (Next)
     )
   )
 )
)

(defpoll spotify_cover :interval "3s" "bash ~/.config/eww/scripts/spotify-cover.sh")

(defwidget Album []
  (box :orientation "vertical" :align "right" :spacing 2
    (box :class "spotify-img"
      :style "background-image: url('${spotify_cover.coverart}');
              background-size: 100% 100%;
              background-repeat: no-repeat;
              background-position: center;
              min-width: 300px;
              min-height: 300px;
              border-radius: 15px;
              margin-bottom: 4px;")
  )
)


(defwidget Previous []
  (box :orientation "horizontal" :align "right" :class "reboot-box"
    (button :onclick "playerctl previous" ; eww close spotify-menu"
      :style "padding: 4px 8px; margin: 4px; border-radius: 10px;"
      (label :text "⏮︎" :style "font-size: 16px;"))
  )
)

(defwidget Play/Pause []
  (box :orientation "horizontal" :align "right" :class "power-off-box"
    (button :onclick "playerctl play-pause" ; eww close spotify-menu"
      :style "padding: 4px 8px; margin: 4px; border-radius: 10px;"
      (label :text "▶︎/⏸︎" :style "font-size: 16px;"))
  )
)

(defwidget Next []
  (box :orientation "horizontal" :align "right" :class "logout-box"
    (button :onclick "playerctl next" ; eww close spotify-menu"
      :style "padding: 4px 8px; margin: 4px; border-radius: 10px;"
      (label :text "⏭︎" :style "font-size: 16px;"))
  )
)




