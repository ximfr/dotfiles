

(defwindow pwrmnu
  :monitor 0
  :geometry (geometry :width "100%" :height "100%" :anchor "center")
  :stacking "overlay"
  :focusable false
  (eventbox :onclick "eww close pwrmnu" ; Close on any click
    (box :orientation "horizontal" :class "main-box"
      (lock)
      (sleep)
      (logout)
      (reboot)
      (power-off)
    )
  )
)




  





(defwidget lock []
  (box :orientation "horizontal" :align "center" :class "lock-box"
    (button :onclick "hyprlock ; eww close pwrmnu"
      (label :text " 󰌾 " :class "sleep-text"))
  )
)
(defwidget logout []
  (box :orientation "horizontal" :align "center" :class "logout-box"
    (button :onclick "niri msg action quit; hyprctl dispatch exit"
      (label :text "  " :class "sleep-text"))
  )
)
(defwidget reboot []
  (box :orientation "horizontal" :align "center" :class "reboot-box"
    (button :onclick "reboot"
      (label :text "  " :class "sleep-text"))
  )
)
(defwidget power-off []
  (box :orientation "horizontal" :align "center" :class "power-off-box"
    (button :onclick "poweroff"
      (label :text "  " :class "sleep-text"))
  )
)
(defwidget sleep []
  (box :orientation "horizontal" :align "center" :class "sleep-box"
    (button :onclick "systemctl suspend ; eww close pwrmnu"
      (label :text " 󰒲 " :class "sleep-text"))
  )
)



